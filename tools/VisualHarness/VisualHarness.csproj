<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool: renders the real Randomiser UI against a mocked Playnite API and saves screenshots. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GameRandomiser.VisualHarness</AssemblyName>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PlayniteSDK" Version="6.17.0" />
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
    <PackageReference Include="Moq" Version="4.18.4" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameRandomiser\GameRandomiser.csproj" />
  </ItemGroup>
</Project>
