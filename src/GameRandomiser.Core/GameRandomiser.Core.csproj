<Project Sdk="Microsoft.NET.Sdk">
  <!-- Playnite-independent domain logic: models, services, spin maths and label layout. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>GameRandomiser.Core</RootNamespace>
    <AssemblyName>GameRandomiser.Core</AssemblyName>
    <!-- NU1903: the advisory concerns parsing untrusted deeply-nested JSON. At runtime Playnite's own
         Newtonsoft copy is used, and we only parse our own data file. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Playnite ships Newtonsoft.Json 10.0.0.0; compile against it but never copy it. -->
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GameRandomiser.Core.Tests" />
  </ItemGroup>
</Project>
