<UserControl x:Class="GameRandomiser.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameRandomiser.Settings">
    <!-- Rendered inside Playnite's Add-on settings page; uses Playnite's own control styles. -->
    <UserControl.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,6,20,20" MaxWidth="760" HorizontalAlignment="Left">

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Theme" Style="{StaticResource Label}" />
                <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,4"
                          ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Settings.Theme}" AutomationProperties.Name="Theme" />
                <TextBlock Grid.Row="1" Text="Accent colour" Style="{StaticResource Label}" />
                <local:ColourPickerButton Grid.Row="1" Grid.Column="1" Margin="0,4" AllowThemeDefault="True"
                                          Colour="{Binding AccentColour, Mode=TwoWay}" AutomationProperties.Name="Accent colour" />
                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,4" Content="Draw borders between segments"
                          IsChecked="{Binding Settings.ShowSegmentBorders}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="The accent colours the Spin button, pointer, active wheel and winner highlight. 'Match Playnite theme' uses your installed Playnite theme's colours." />

            <TextBlock Text="Segment colours" FontWeight="SemiBold" Margin="0,12,0,4" />
            <TextBlock Style="{StaticResource Hint}" Text="Segments cycle through these colours. Text colour is chosen automatically for contrast." />
            <ItemsControl ItemsSource="{Binding SegmentColours}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,8">
                            <local:ColourPickerButton Colour="{Binding Hex, Mode=TwoWay}" />
                            <Button Content="✕" Padding="7,2" Margin="4,0,0,0" ToolTip="Remove colour" AutomationProperties.Name="Remove colour"
                                    Command="{Binding DataContext.RemoveColourCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Add colour" Padding="10,4" Command="{Binding AddColourCommand}" />
                <Button Content="Reset to defaults" Padding="10,4" Margin="8,0,0,0" Command="{Binding ResetColoursCommand}" />
            </StackPanel>

            <!-- Wheel -->
            <TextBlock Text="Wheel" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Default wheel" Style="{StaticResource Label}" />
                <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,4"
                          ItemsSource="{Binding DefaultWheelOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding DefaultWheelId}" AutomationProperties.Name="Default wheel" />
                <TextBlock Grid.Row="1" Text="Show games as" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,4"
                          ItemsSource="{Binding DisplayModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Settings.DisplayMode}" AutomationProperties.Name="Game representation" />
                <TextBlock Grid.Row="2" Text="Arrange new wheels" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="2" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,4"
                          ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Settings.DefaultSortMode}" AutomationProperties.Name="Default arrangement" />
                <CheckBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,4" Content="Show recent picks beside the wheel when there's room"
                          IsChecked="{Binding Settings.ShowRecentPicksWhenWide}" />
            </Grid>
            <TextBlock Style="{StaticResource Hint}" Text="Covers, icons and titles adapt automatically to the space available; very large wheels fall back to compact labels. Hover a segment to see its full name." />

            <!-- Animation -->
            <TextBlock Text="Animation" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Spin duration" Style="{StaticResource Label}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="2s" VerticalAlignment="Center" Opacity="0.7" />
                    <Slider Width="240" Minimum="2" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="8,0"
                            Value="{Binding SpinDurationSeconds}" AutomationProperties.Name="Spin duration in seconds" />
                    <TextBlock Text="10s" VerticalAlignment="Center" Opacity="0.7" />
                    <TextBlock Text="{Binding SpinDurationText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="Spin speed" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,4"
                          ItemsSource="{Binding IntensityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Settings.SpinIntensity}" AutomationProperties.Name="Spin speed" />
            </Grid>

            <!-- Sound -->
            <TextBlock Text="Sound" Style="{StaticResource Section}" />
            <CheckBox Content="Tick sounds as segments pass the pointer" IsChecked="{Binding Settings.TickSoundEnabled}" Margin="0,4" />
            <CheckBox Content="Play a sound when a winner is picked" IsChecked="{Binding Settings.WinnerSoundEnabled}" Margin="0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Volume" Width="200" VerticalAlignment="Center" />
                <Slider Width="240" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding Volume}" AutomationProperties.Name="Volume" />
                <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Winner -->
            <TextBlock Text="Winner" Style="{StaticResource Section}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Winner presentation" Style="{StaticResource Label}" />
                <ComboBox Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,4"
                          ItemsSource="{Binding PresentationOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Settings.WinnerPresentation}" AutomationProperties.Name="Winner presentation" />
                <TextBlock Grid.Row="1" Text="After winning" Style="{StaticResource Label}" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="260" HorizontalAlignment="Left" Margin="0,4"
                          ItemsSource="{Binding BehaviourOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Settings.WinnerBehaviour}" AutomationProperties.Name="After winning" />
            </Grid>
            <CheckBox Content="Automatically launch the winning game (if installed)" IsChecked="{Binding Settings.AutoLaunchWinner}" Margin="0,10,0,4" />
            <CheckBox Content="Celebrate with confetti" IsChecked="{Binding Settings.ShowConfetti}" Margin="0,4" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                       Text="Every game on a wheel always has exactly the same chance of winning. Arrangement, history, playtime and install state never affect the odds." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
