<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Styles for the sidebar view. Every colour is a DynamicResource "GR.*" brush published by
        ThemeService, so switching Light / Dark / Native re-skins everything without rebuilding views.
    -->

    <Style x:Key="GR.Text" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="GR.MutedText" TargetType="TextBlock" BasedOn="{StaticResource GR.Text}">
        <Setter Property="Foreground" Value="{DynamicResource GR.TextMuted}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="GR.Heading" TargetType="TextBlock" BasedOn="{StaticResource GR.Text}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource GR.TextMuted}" />
    </Style>

    <Style x:Key="GR.Title" TargetType="TextBlock" BasedOn="{StaticResource GR.Text}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="GR.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="8" RadiusY="8" StrokeThickness="2"
                               Stroke="{DynamicResource GR.Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base button: rounded surface button that follows the theme. -->
    <Style x:Key="GR.Button" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="Background" Value="{DynamicResource GR.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GR.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="HoverBd" CornerRadius="6" Background="{DynamicResource GR.Hover}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBd" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverBd" Property="Opacity" Value="1.6" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GR.AccentButton" TargetType="ButtonBase" BasedOn="{StaticResource GR.Button}">
        <Setter Property="Foreground" Value="{DynamicResource GR.AccentText}" />
        <Setter Property="Background" Value="{DynamicResource GR.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="GR.SpinButton" TargetType="Button" BasedOn="{StaticResource GR.AccentButton}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Padding" Value="46,11" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="26" Background="{TemplateBinding Background}" Opacity="0.25" Margin="-4" />
                        <Border x:Name="Bd" CornerRadius="24" Background="{TemplateBinding Background}" />
                        <Border x:Name="HoverBd" CornerRadius="24" Background="#26FFFFFF" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBd" Property="Opacity" Value="1" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, borderless button for toolbars and icon-only controls (always given a ToolTip). -->
    <Style x:Key="GR.FlatButton" TargetType="ButtonBase" BasedOn="{StaticResource GR.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="9,6" />
    </Style>

    <Style x:Key="GR.DangerButton" TargetType="ButtonBase" BasedOn="{StaticResource GR.Button}">
        <Setter Property="Foreground" Value="#E05858" />
    </Style>

    <!-- Tabs in the header: radio buttons with an accent underline when selected. -->
    <Style x:Key="GR.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource GR.TextMuted}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="HoverBd" CornerRadius="6" Background="{DynamicResource GR.Hover}" Opacity="0" />
                        <ContentPresenter Margin="10,6,10,8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="Underline" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="8,0"
                                Background="{DynamicResource GR.Accent}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBd" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GR.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="Background" Value="{DynamicResource GR.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GR.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GR.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource GR.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                                       Foreground="{DynamicResource GR.TextMuted}" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GR.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GR.CheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                BorderBrush="{DynamicResource GR.TextMuted}" Background="Transparent" VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 3,9 L 7,13 L 14,4" Stroke="{DynamicResource GR.AccentText}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GR.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GR.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GR.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lists: transparent rows, hover tint, accent bar on the selected row. -->
    <Style x:Key="GR.ListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent" Margin="0,1">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,6"
                                Background="{DynamicResource GR.Accent}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GR.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GR.AccentSoft}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GR.Accent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GR.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GR.ListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Themed combo box (wheel selector, sort selector). -->
    <Style x:Key="GR.ComboItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GR.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GR.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GR.ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GR.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource GR.Text}" />
        <Setter Property="Background" Value="{DynamicResource GR.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GR.Border}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource GR.ComboItem}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                        <Border x:Name="HoverBd" CornerRadius="6" Background="{DynamicResource GR.Hover}" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" />
                            <Path Grid.Column="1" Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource GR.TextMuted}" StrokeThickness="1.8"
                                  Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ToggleButton Style="{StaticResource GR.ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Placement="Bottom" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource GR.SolidBackground}" BorderBrush="{DynamicResource GR.Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="2,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBd" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GR.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GR.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GR.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GR.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="GR.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
