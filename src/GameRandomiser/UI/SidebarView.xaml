<UserControl x:Class="GameRandomiser.UI.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameRandomiser.UI"
             Background="{DynamicResource GR.Background}"
             Focusable="True"
             FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameRandomiser;component/UI/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Margin="16,10,10,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="🎲" FontSize="18" Style="{StaticResource GR.Text}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="HeaderTitle" Text="GAME RANDOMISER" Style="{StaticResource GR.Text}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource GR.Tab}" GroupName="GRTabs" Content="Wheel" IsChecked="{Binding IsWheelTab, Mode=TwoWay}"
                             ToolTip="Spin the wheel" />
                <RadioButton Style="{StaticResource GR.Tab}" GroupName="GRTabs" Content="Wheels" IsChecked="{Binding IsManageTab, Mode=TwoWay}"
                             ToolTip="Create and manage wheels and their games" />
                <RadioButton Style="{StaticResource GR.Tab}" GroupName="GRTabs" Content="History" IsChecked="{Binding IsHistoryTab, Mode=TwoWay}"
                             ToolTip="Recent picks for the current wheel" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GR.FlatButton}" Click="Settings_Click" Margin="4,0,0,0"
                    ToolTip="Randomiser settings" AutomationProperties.Name="Randomiser settings">
                <TextBlock Text="⚙" FontSize="18" Style="{StaticResource GR.Text}" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <!-- ============ Wheel tab ============ -->
            <Grid x:Name="WheelTab" Visibility="{Binding IsWheelTab, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="RecentColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- First run -->
                <StackPanel Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24">
                    <TextBlock Text="🎲" FontSize="64" HorizontalAlignment="Center" Style="{StaticResource GR.Text}" />
                    <TextBlock Text="Welcome to Game Randomiser" Style="{StaticResource GR.Title}" Margin="0,10,0,8" />
                    <TextBlock Style="{StaticResource GR.MutedText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                               Text="You don't have any wheels yet. Create one manually, or automatically from your Playnite library." />
                    <Button Style="{StaticResource GR.AccentButton}" Content="CREATE WHEEL" Margin="0,20,0,0" Padding="30,11"
                            HorizontalAlignment="Center" Click="CreateWheel_Click" FontSize="15" />
                    <TextBlock Style="{StaticResource GR.MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,16,0,0"
                               Text="Tip: you can also right-click games in your library and choose Game Randomiser." />
                </StackPanel>

                <!-- Wheel -->
                <Grid Visibility="{Binding ShowWheel, Converter={StaticResource BoolToVis}}" Margin="12,0,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ComboBox Style="{StaticResource GR.ComboBox}" Margin="4,6,4,6" MaxWidth="560"
                              ItemsSource="{Binding Wheels}" SelectedItem="{Binding SelectedWheel, Mode=TwoWay}"
                              IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Current wheel" ToolTip="Choose which wheel to spin">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding AccessibleName}">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource GR.Text}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GR.Text}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CountText}" Style="{StaticResource GR.MutedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="· auto" Style="{StaticResource GR.MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Grid.Row="1">
                        <local:WheelControl x:Name="Wheel" />
                        <Border Visibility="{Binding IsWheelEmpty, Converter={StaticResource BoolToVis}}" Style="{StaticResource GR.Card}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="20" Padding="22">
                            <StackPanel>
                                <TextBlock Text="No games in this wheel" Style="{StaticResource GR.Text}" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource GR.MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                           Text="Add games from your Playnite library, or create an automatically populated wheel." />
                                <Button Style="{StaticResource GR.AccentButton}" Content="ADD GAMES" Margin="0,16,0,0" Padding="24,9"
                                        HorizontalAlignment="Center" Click="AddGames_Click" />
                                <TextBlock Style="{StaticResource GR.MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" FontSize="12"
                                           Text="Or right-click games in your library → Game Randomiser." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button x:Name="SpinButton" Grid.Row="2" Style="{StaticResource GR.SpinButton}" Content="SPIN" Margin="0,10,0,8"
                            IsEnabled="{Binding CanSpin}" Click="Spin_Click"
                            AutomationProperties.Name="Spin the wheel" ToolTip="Spin the wheel (you can also click the wheel)" />

                    <!-- Reroll protection: what the next spin will do, or why it can't happen yet -->
                    <WrapPanel x:Name="ProtectionBar" Grid.Row="3" HorizontalAlignment="Center" MaxWidth="560" Margin="4,0,4,6"
                               Visibility="{Binding HasProtectionStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock x:Name="ProtectionStatus" Text="{Binding ProtectionStatusText}" Style="{StaticResource GR.MutedText}" TextWrapping="Wrap"
                                   TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"
                                   AutomationProperties.Name="Reroll protection status" />
                        <Button Style="{StaticResource GR.FlatButton}" Content="Accept pick" Click="AcceptPick_Click"
                                Visibility="{Binding CanAcceptPick, Converter={StaticResource BoolToVis}}"
                                ToolTip="Keep the last pick. Your rerolls are restored for the next round." />
                        <Button Style="{StaticResource GR.FlatButton}" Content="Reset" Click="ResetProtection_Click"
                                Visibility="{Binding CanResetProtection, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Reset reroll protection"
                                ToolTip="Forget recent winners, used rerolls and any cooldown for this wheel" />
                    </WrapPanel>

                    <Grid Grid.Row="4" MaxWidth="560" Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding GameCountText}" Style="{StaticResource GR.MutedText}" VerticalAlignment="Center" FontSize="14" />
                            <Border x:Name="DynamicBadge" Style="{StaticResource GR.Badge}" Background="{DynamicResource GR.SurfaceAlt}" Margin="8,0,0,0"
                                    Visibility="{Binding DynamicBadgeText, Converter={StaticResource NullToVis}}"
                                    ToolTip="{Binding DynamicBadgeToolTip}">
                                <TextBlock Text="{Binding DynamicBadgeText}" Style="{StaticResource GR.MutedText}" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GR.FlatButton}" Click="Shuffle_Click" IsEnabled="{Binding CanEdit}"
                                ToolTip="Shuffle the arrangement. Doesn't pick a winner or count as a spin." AutomationProperties.Name="Shuffle wheel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔀" Style="{StaticResource GR.Text}" Margin="0,0,6,0" />
                                <TextBlock x:Name="ShuffleLabel" Text="Shuffle" Style="{StaticResource GR.Text}" />
                            </StackPanel>
                        </Button>
                        <ComboBox Grid.Column="2" Style="{StaticResource GR.ComboBox}" MinWidth="120" Margin="6,0,0,0"
                                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                                  ToolTip="How games are arranged around the wheel. Every game always has an equal chance."
                                  AutomationProperties.Name="Wheel order">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource GR.Text}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Grid>

                <!-- Recent picks (wide layouts only) -->
                <Border x:Name="RecentPanel" Grid.Column="1" Style="{StaticResource GR.Card}" Margin="0,8,16,16" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="RECENT PICKS" Style="{StaticResource GR.Heading}" Margin="0,0,0,10" />
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource GR.FlatButton}" Content="View full history" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Click="ShowHistory_Click" />
                        <Grid>
                            <TextBlock Text="Spin the wheel to start your history." Style="{StaticResource GR.MutedText}" TextWrapping="Wrap"
                                       Visibility="{Binding HasHistory, Converter={StaticResource InvBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding RecentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="48" CornerRadius="4" Background="{DynamicResource GR.SurfaceAlt}" Margin="0,0,10,0">
                                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource GR.Text}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding WhenText}" Style="{StaticResource GR.MutedText}" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ Manage tab ============ -->
            <Grid x:Name="ManageTab" Visibility="{Binding IsManageTab, Converter={StaticResource BoolToVis}}" Margin="16,6,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ManageLeftColumn" Width="*" />
                    <ColumnDefinition x:Name="ManageRightColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ManageTopRow" Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="WheelsPanel" Style="{StaticResource GR.Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GR.AccentButton}" Content="+ CREATE WHEEL" Padding="12,6" Click="CreateWheel_Click" />
                            <TextBlock Text="WHEELS" Style="{StaticResource GR.Heading}" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsEnabled="{Binding HasWheels}">
                            <Button Style="{StaticResource GR.Button}" Content="Rename" Margin="0,0,6,6" Click="Rename_Click" ToolTip="Rename the selected wheel" />
                            <Button x:Name="IconButton" Style="{StaticResource GR.Button}" Content="Icon" Margin="0,0,6,6" Click="Icon_Click" ToolTip="Change the selected wheel's icon" />
                            <Button Style="{StaticResource GR.Button}" Content="Duplicate" Margin="0,0,6,6" Click="Duplicate_Click" ToolTip="Copy this wheel and its games" />
                            <Button Style="{StaticResource GR.Button}" Content="Clear games" Margin="0,0,6,6" Click="Clear_Click" ToolTip="Remove every game from this wheel" />
                            <Button Style="{StaticResource GR.Button}" Content="Refresh from criteria" Margin="0,0,6,6" Click="RefreshCriteria_Click"
                                    Visibility="{Binding CanRefreshFromCriteria, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Check the library against this wheel's criteria now" />
                            <Button Style="{StaticResource GR.DangerButton}" Content="Delete" Margin="0,0,6,6" Click="Delete_Click" ToolTip="Delete this wheel (games stay in your library)" />
                        </WrapPanel>
                        <Grid>
                            <TextBlock Text="No wheels yet. Create one to get started." Style="{StaticResource GR.MutedText}" Margin="4"
                                       Visibility="{Binding HasWheels, Converter={StaticResource InvBoolToVis}}" />
                            <ListBox x:Name="WheelsList" Style="{StaticResource GR.List}" MaxHeight="280"
                                     ItemsSource="{Binding Wheels}" SelectedItem="{Binding SelectedWheel, Mode=TwoWay}"
                                     AutomationProperties.Name="Wheels">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding AccessibleName}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource GR.Text}" FontSize="16" Margin="4,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GR.Text}" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource GR.Badge}" Background="{DynamicResource GR.AccentSoft}" Margin="8,0,0,0"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="current" Style="{StaticResource GR.Text}" FontSize="11" />
                                                    </Border>
                                                    <Border Style="{StaticResource GR.Badge}" Background="{DynamicResource GR.SurfaceAlt}" Margin="6,0,0,0"
                                                            Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="This wheel keeps itself in sync with its criteria">
                                                        <TextBlock Text="auto" Style="{StaticResource GR.MutedText}" FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource GR.MutedText}" FontSize="12"
                                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource GR.MutedText}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border x:Name="GamesPanel" Grid.Row="1" Style="{StaticResource GR.Card}" IsEnabled="{Binding HasWheels}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding ManageHeader}" Style="{StaticResource GR.Heading}" />
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource GR.MutedText}" FontSize="12" Margin="0,2,0,0"
                                   Text="{Binding ActiveWheelDescription, StringFormat=Created from: {0}}"
                                   Visibility="{Binding ActiveWheelDescription, Converter={StaticResource NullToVis}}" />
                        <!-- Membership policy: only for wheels created from criteria -->
                        <StackPanel x:Name="MembershipPanel" DockPanel.Dock="Top" Margin="0,8,0,0"
                                    Visibility="{Binding CanRefreshFromCriteria, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock Text="Updates" Style="{StaticResource GR.MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="PolicyCombo" Style="{StaticResource GR.ComboBox}" HorizontalAlignment="Left" MinWidth="230"
                                          ItemsSource="{Binding PolicyOptions}" SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Membership policy"
                                          ToolTip="{Binding SelectedPolicy.Description}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource GR.Text}" ToolTip="{Binding Description}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <TextBlock x:Name="RefreshStatus" Text="{Binding RefreshStatusText}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                       Visibility="{Binding ShowRefreshStatus, Converter={StaticResource BoolToVis}}"
                                       ToolTip="{Binding RefreshStatusDetail}" AutomationProperties.Name="Refresh status">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GR.MutedText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshStale}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource GR.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBox DockPanel.Dock="Top" Style="{StaticResource GR.TextBox}" Tag="Search games…" Margin="0,10,0,6"
                                 Text="{Binding ManageSearch, UpdateSourceTrigger=PropertyChanged, Delay=150}" AutomationProperties.Name="Search games in this wheel" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Style="{StaticResource GR.AccentButton}" Content="Add games" Margin="0,0,6,6" Click="AddGames_Click" ToolTip="Pick games from your library" />
                            <Button Style="{StaticResource GR.Button}" Content="Remove selected" Margin="0,0,6,6" Click="RemoveSelected_Click" ToolTip="Remove the ticked games from this wheel" />
                            <Button Style="{StaticResource GR.Button}" Content="📌 Pin selected" Margin="0,0,6,6" Click="PinSelected_Click"
                                    Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Pin selected games"
                                    ToolTip="Keep the ticked games on this wheel even if they stop matching the criteria" />
                            <Button Style="{StaticResource GR.Button}" Content="Unpin selected" Margin="0,0,6,6" Click="UnpinSelected_Click"
                                    Visibility="{Binding CanPin, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Let the criteria decide whether the ticked games stay on this wheel" />
                            <Button Style="{StaticResource GR.Button}" Content="{Binding RestoreRemovedText}" Margin="0,0,6,6" Click="RestoreRemoved_Click"
                                    Visibility="{Binding CanRestoreRemoved, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Games you removed from this wheel stay off it. This lets them return if they still match." />
                            <Button Style="{StaticResource GR.Button}" Content="Select all" Margin="0,0,6,6" Click="SelectAll_Click" />
                            <Button Style="{StaticResource GR.Button}" Content="Select none" Margin="0,0,6,6" Click="SelectNone_Click" />
                            <Button Style="{StaticResource GR.FlatButton}" Content="← Back to wheel" Margin="0,0,6,6" Click="BackToWheel_Click" />
                        </WrapPanel>
                        <Grid>
                            <TextBlock Text="This wheel has no games yet. Use Add games, or right-click games in your library."
                                       Style="{StaticResource GR.MutedText}" TextWrapping="Wrap" Margin="4,8"
                                       Visibility="{Binding HasManageGames, Converter={StaticResource InvBoolToVis}}" />
                            <ListBox Style="{StaticResource GR.List}" ItemsSource="{Binding ManageGamesView}" AutomationProperties.Name="Games in this wheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource GR.CheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" AutomationProperties.Name="{Binding AccessibleName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GR.Text}" />
                                                    <TextBlock Text="📌 pinned" Style="{StaticResource GR.MutedText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                                               ToolTip="Stays on this wheel even if it stops matching the criteria" />
                                                </StackPanel>
                                            </CheckBox>
                                            <Border Grid.Column="1" Style="{StaticResource GR.Badge}" Background="{DynamicResource GR.SurfaceAlt}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding InstallText}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GR.MutedText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource GR.Success}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ============ History tab ============ -->
            <Border x:Name="HistoryTab" Visibility="{Binding IsHistoryTab, Converter={StaticResource BoolToVis}}" Style="{StaticResource GR.Card}" Margin="16,6,16,16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GR.Button}" Content="Clear history" Click="ClearHistory_Click"
                                IsEnabled="{Binding HasHistory}" ToolTip="Forget the spin history for this wheel" />
                        <TextBlock Text="{Binding HistoryHeader}" Style="{StaticResource GR.Heading}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <TextBlock Text="No spins yet. Every spin of this wheel will be listed here."
                                   Style="{StaticResource GR.MutedText}" TextWrapping="Wrap" Margin="4"
                                   Visibility="{Binding HasHistory, Converter={StaticResource InvBoolToVis}}" />
                        <ListBox x:Name="HistoryList" Style="{StaticResource GR.List}" ItemsSource="{Binding HistoryItems}"
                                 MouseDoubleClick="HistoryList_MouseDoubleClick" AutomationProperties.Name="Spin history">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="Double-click to view in your library">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number, StringFormat={}{0}.}" Style="{StaticResource GR.MutedText}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Width="32" Height="46" CornerRadius="4" Background="{DynamicResource GR.SurfaceAlt}" Margin="0,0,12,0">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource GR.Text}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource GR.MutedText}" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding WhenText}" Style="{StaticResource GR.MutedText}" VerticalAlignment="Center" Margin="10,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ============ Winner overlay ============ -->
            <Grid x:Name="WinnerOverlay" Visibility="Collapsed">
                <Border x:Name="WinnerBackdrop" Background="{DynamicResource GR.Overlay}" />

                <!-- Full card -->
                <Border x:Name="WinnerCard" Style="{StaticResource GR.Card}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Width="380" BorderBrush="{DynamicResource GR.Accent}" BorderThickness="2" Padding="0" CornerRadius="14"
                        RenderTransformOrigin="0.5,0.5" DataContext="{Binding Winner}" AutomationProperties.Name="Winner">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="WinnerCardScale" />
                    </Border.RenderTransform>
                    <Grid>
                        <ScrollViewer x:Name="WinnerScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="22,18,22,20">
                                <TextBlock Text="🏆  WINNER!" Foreground="{DynamicResource GR.Accent}" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding WheelName, StringFormat=from {0}}" Style="{StaticResource GR.MutedText}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <Border x:Name="WinnerCoverFrame" Width="180" Height="252" CornerRadius="10" Margin="0,14,0,12" HorizontalAlignment="Center"
                                        Background="{DynamicResource GR.SurfaceAlt}">
                                    <Grid>
                                        <TextBlock Text="🎮" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource GR.MutedText}"
                                                   Visibility="{Binding HasCover, Converter={StaticResource InvBoolToVis}}" />
                                        <Border CornerRadius="10" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource GR.Title}" FontSize="22" TextTrimming="None" />
                                <Border Style="{StaticResource GR.Badge}" Background="{DynamicResource GR.SurfaceAlt}" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource GR.MutedText}" FontSize="12" />
                                </Border>

                                <TextBlock Text="What would you like to do?" Style="{StaticResource GR.MutedText}" HorizontalAlignment="Center" Margin="0,14,0,0"
                                           Visibility="{Binding ShowAskPrompt, Converter={StaticResource InvBoolToVis}}" />
                                <TextBlock Text="Keep it on the wheel, or remove it?" Style="{StaticResource GR.MutedText}" HorizontalAlignment="Center" Margin="0,14,0,0"
                                           Visibility="{Binding ShowAskPrompt, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                            Visibility="{Binding WasRemoved, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding WheelName, StringFormat=Removed from {0}.}" Style="{StaticResource GR.MutedText}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource GR.FlatButton}" Content="Undo" Foreground="{DynamicResource GR.Accent}" Click="UndoRemove_Click" Margin="4,0,0,0" />
                                </StackPanel>

                                <TextBlock x:Name="WinnerProtection" Text="{Binding ProtectionText}" Style="{StaticResource GR.MutedText}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"
                                           Visibility="{Binding ProtectionText, Converter={StaticResource NullToVis}}"
                                           AutomationProperties.Name="Reroll protection" />
                                <Button Style="{StaticResource GR.AccentButton}" Content="SPIN AGAIN" Margin="0,14,0,0" Padding="12,10" FontSize="15" Click="SpinAgain_Click"
                                        IsEnabled="{Binding CanSpinAgain}" />
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Button Style="{StaticResource GR.Button}" Content="✓  Accept pick" Margin="0,0,4,0" Click="AcceptPick_Click"
                                            Visibility="{Binding CanAccept, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Keep this pick. Your rerolls are restored for the next round." />
                                    <Button Style="{StaticResource GR.Button}" Content="Reset protection" Margin="4,0,0,0" Click="ResetProtection_Click"
                                            Visibility="{Binding CanResetProtection, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Forget recent winners, used rerolls and any cooldown for this wheel" />
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <Button Style="{StaticResource GR.Button}" Content="▶  Launch" Margin="0,0,4,8" Click="Launch_Click"
                                            Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}" ToolTip="Launch with Playnite" />
                                    <Button Style="{StaticResource GR.Button}" Content="⬇  Install" Margin="0,0,4,8" Click="Install_Click"
                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}" ToolTip="Install with Playnite" />
                                    <Button Style="{StaticResource GR.Button}" Content="✕  Remove" Margin="4,0,0,8" Click="Remove_Click"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" ToolTip="Remove from this wheel (not from your library)" />
                                    <Button Style="{StaticResource GR.Button}" Content="ℹ  View details" Margin="0,0,4,8" Click="Details_Click" ToolTip="Show the game in your Playnite library" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Style="{StaticResource GR.FlatButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Click="CloseWinner_Click"
                                ToolTip="Close" AutomationProperties.Name="Close winner">
                            <TextBlock Text="✕" Style="{StaticResource GR.MutedText}" FontSize="15" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Compact banner -->
                <Border x:Name="WinnerBanner" Style="{StaticResource GR.Card}" VerticalAlignment="Bottom" Margin="16" MaxWidth="760"
                        BorderBrush="{DynamicResource GR.Accent}" BorderThickness="2" CornerRadius="14" DataContext="{Binding Winner}"
                        RenderTransformOrigin="0.5,1" AutomationProperties.Name="Winner">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="WinnerBannerScale" />
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="60" Height="84" CornerRadius="6" Background="{DynamicResource GR.SurfaceAlt}" Margin="0,0,14,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource GR.MutedText}"
                                           Visibility="{Binding HasCover, Converter={StaticResource InvBoolToVis}}" />
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="🏆 WINNER!" Foreground="{DynamicResource GR.Accent}" FontWeight="Black" FontSize="14" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource GR.Text}" FontSize="19" FontWeight="Bold" />
                            <TextBlock Style="{StaticResource GR.MutedText}" FontSize="12">
                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                <Run Text="{Binding WheelName, Mode=OneWay, StringFormat=· {0}}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource GR.MutedText}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding ProtectionText, Converter={StaticResource NullToVis}}"
                                       AutomationProperties.Name="Reroll protection" />
                        </StackPanel>
                        <WrapPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GR.AccentButton}" Content="Spin again" Margin="4" Click="SpinAgain_Click"
                                    IsEnabled="{Binding CanSpinAgain}" />
                            <Button Style="{StaticResource GR.Button}" Content="Accept pick" Margin="4" Click="AcceptPick_Click"
                                    Visibility="{Binding CanAccept, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GR.Button}" Content="Reset protection" Margin="4" Click="ResetProtection_Click"
                                    Visibility="{Binding CanResetProtection, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GR.Button}" Content="Launch" Margin="4" Click="Launch_Click"
                                    Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GR.Button}" Content="Install" Margin="4" Click="Install_Click"
                                    Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GR.Button}" Content="Remove" Margin="4" Click="Remove_Click"
                                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GR.Button}" Content="Undo remove" Margin="4" Click="UndoRemove_Click"
                                    Visibility="{Binding WasRemoved, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource GR.Button}" Content="Details" Margin="4" Click="Details_Click" />
                            <Button Style="{StaticResource GR.FlatButton}" Content="✕" Margin="4" Click="CloseWinner_Click" ToolTip="Close" AutomationProperties.Name="Close winner" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>

            <local:ConfettiLayer x:Name="Confetti" />
        </Grid>
    </Grid>
</UserControl>
